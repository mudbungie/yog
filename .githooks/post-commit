#!/usr/bin/env bash
# yog post-commit hook: automatic upstream delivery.
#
# When a commit lands on main (a bl-close squash-merge), push it to origin.
# Delivery must NEVER fail the commit: a push error only warns and exits 0.
# No-ops on a detached HEAD or when no 'origin' remote is configured.

branch="$(git symbolic-ref --short HEAD 2>/dev/null || true)"
[ "$branch" = "main" ] || exit 0
git remote get-url origin >/dev/null 2>&1 || exit 0

if ! git push --quiet origin main; then
  echo "post-commit: push to origin/main failed; deliver manually with 'git push origin main'." >&2
fi
exit 0
