#!/usr/bin/env bash
# yog gate — what a commit on this box must pass (bl-1b8d; ops bl-3e3f,
# ~/ops/remote-builds.md "Repo gate"). Called by .githooks/pre-commit, which
# keeps only the commit-context guard and delegates here.
#
# THIS LAPTOP DOES NOT COMPILE. The gate's targets are `make check`
# (AGENTS.md "The gate"); the noodlezoo builder runs them on the staged tree in
# a container whose rustc is the rust-toolchain.toml pin and signs a
# bl-speculate verdict; bl-remote-gate (userconf) brings it home. Three steps,
# no fourth:
#   1. `make leak-scan` here — cheap, and the one thing that must never leave
#      the box unscanned (bl-167d, below);
#   2. the verdict cache (bl-speculate's `check`) — a verified verdict for this exact tree under
#      this toolchain already passed: done;
#   3. `bl-remote-gate` — its exit is the gate's exit.
# There is no local build path. If the builder is unreachable the answer is
# 75, not `make check` here. The GitHub Actions merge-queue builder
# (.github/workflows/speculate.yml, driven by scripts/speculate-gate) runs the
# same `make check` for a public-repo close and is unchanged by this file.
#
# THE EXIT CODE IS A CONTRACT, because callers write a cached verdict from it
# (bl-673a) and a stored FAIL is permanent — balls' `speculate_run` stops the
# candidate chain at one on every later pass without rebuilding:
#   0    the tree passed — a verified PASS for (tree, toolchain) is in the
#        local store (an old hit, or the one bl-remote-gate just imported).
#   1    the builder judged the tree and FAILED it (verified). Fix the tree.
#   75   NO VERDICT: builder unreachable, no `check` target, a tool missing
#        from the image, an unverifiable signature, a fingerprint miss.
#        Nothing is recorded; the commit is refused; the next attempt rebuilds.
#
# THE VERDICT KEY. A verdict is keyed by (tree, BALLS_TOOLCHAIN). This file
# and every script it calls are tracked, so they are INSIDE the tree oid:
# editing one re-keys every stored verdict, which is exactly the invalidation a
# gate upgrade must cause (balls bl-6a84 dropped the compiled-in gate-file list
# that once hashed four of them a second time). The toolchain half is
# exported ONCE here (balls >= 0.5.13 requires the gate to say it; nothing
# derives it elsewhere) and inherited by both tools. The builder's rustc is
# the rust-toolchain.toml pin, so the string is byte-identical on both sides —
# and a verdict from a box whose bl-speculate derives the key differently can
# never hit (bl-5909): install the crates.io version Cargo.toml pins.

set -euo pipefail

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

# When git invokes the hook it exports GIT_DIR, GIT_INDEX_FILE and friends;
# they leak into every git subprocess the gates spawn and silently retarget it
# at THIS repo (bl-remote-gate's `git write-tree` included — see
# tests/git_env_scrub.rs). Scrub so the tools run as from a clean shell.
# shellcheck disable=SC2046
unset $(git rev-parse --local-env-vars)

for tool in rustc bl-speculate bl-remote-gate; do
  command -v "$tool" >/dev/null 2>&1 || { echo "error: $tool not installed; cannot run the gate." >&2; exit 1; }
done
export BALLS_TOOLCHAIN="$(rustc -V)"

# THE DISCLOSURE GATE IS NEVER CACHED (bl-167d). Everything below this line
# may be skipped on a verdict-cache hit; this may not. Two reasons, and either
# alone is enough:
#
#   - a verdict is keyed by the TREE, and the scanner and its rule table are
#     in the tree, so a rule edit does re-key every verdict (balls bl-6a84).
#     What a key cannot say is that the tree was scanned by THIS box's rules
#     at THIS moment — the scan is the one step whose answer must never be
#     taken on trust, so it is not cacheable at all.
#   - a verdict is a claim, and every verdict now arrives from somewhere else:
#     the noodlezoo builder signs one, the speculate workflow uploads one, and
#     both are imported. Every other gate step is a build another box did;
#     this one decides whether something leaves the building. It runs on the
#     tree in hand, under the scanner in hand, every time.
#
# ~5s, and it runs FIRST, so a leak fails before anything is pushed anywhere.
# `make lint` runs it again on the builder; that is the price of `lint`
# staying the whole static gate rather than a subset.
echo "gate: leak-scan (make leak-scan)..." >&2
make leak-scan >&2

if bl-speculate check; then
  echo "gate: verdict cache hit — this exact tree already passed this exact gate." >&2
  exit 0
fi
echo "gate: no verdict yet — building on the noodlezoo builder (bl-remote-gate)..." >&2
bl-remote-gate
echo "gate: OK (remote verdict verified and imported)." >&2
