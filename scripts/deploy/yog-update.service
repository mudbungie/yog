# The reconciler, run by `yog-update.timer` (bl-bf35). Oneshot: it does its two
# reconciliations and exits, and a deferral is a normal exit — see the script.
[Unit]
Description=reconcile the installed yog against the registry
Documentation=https://github.com/mudbungie/yog
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=%h/.local/bin/yog-update
# A build is the long pole and runs on the server's own cores; a stuck one must
# not sit forever holding the next tick out.
TimeoutStartSec=30min
# `cargo` and the `cc` a build shells to, plus `systemctl`.
Environment=PATH=%h/.cargo/bin:%h/.local/bin:/usr/local/bin:/usr/bin:/bin
# Build heat must never outrank the engine it is building for: the whole point
# of this box is the agents already running on it.
Nice=10
IOSchedulingClass=idle
