#!/usr/bin/env bash
# Remote-build driver for the bl-24e7 merge queue (bl-1a5b): makes
# `bl-speculate run` build on GitHub Actions instead of this machine.
# bl-speculate run checks each candidate commit out into a detached build dir
# and runs its --gate command there, only the exit code speaking; THIS is
# that command. The remote builder is pure gate policy — balls is untouched.
#
#   1. push the candidate (this build dir's HEAD) to speculation/<sha>;
#   2. .github/workflows/speculate.yml runs the stock gate on it and uploads
#      the runner's verdict store as artifact `verdicts`;
#   3. wait on that exact run (gh run watch), download + bl-speculate import;
#   4. sweep the branch (the TTL sweep is us; a crash leaves the branch —
#      sweep by hand: git push origin --delete speculation/<sha>);
#   5. answer in THREE words, not two (balls bl-1643, `speculate_run::build`
#      maps the exit: 0 is a PASS, 75 is "no verdict — record nothing, the
#      next pass rebuilds", anything else is a FAIL):
#        0   `bl-speculate check` hits: the imported verdict is a PASS under
#            the LOCAL key (tree + local `rustc -V`);
#        1   the runner judged this tree and FAILED it;
#        75  everything else — nothing came home (the workflow records no
#            verdict when the gate was killed from outside, bl-673a), or the
#            runner's verdict for this tree sits under a gate key that is not
#            ours. That second case is a fingerprint MISS: the runner's
#            `rustc -V` differs from this box's (rust-toolchain.toml pins both
#            sides; see the workflow header), or this box runs a bl-speculate
#            that derives the key differently from the version Cargo.toml pins
#            (bl-5909). Either is a fact about the machines, not the tree.
#
# WHY THE THIRD WORD MATTERS. A stored FAIL is permanent: `speculate_run` stops
# the candidate chain at it on every later pass without rebuilding, and only a
# new commit escapes, because the key is the tree. Before balls 0.5.12 this
# script's exit was binary and the caller wrote a verdict from it either way,
# so an empty artifact bought a second remote build, and a key mismatch wrote a
# false FAIL for a tree the runner had passed (bl-5909 measured one). Both are
# 75 now; the next pass is the retry.
#
# Usage:    bl-speculate run --gate scripts/speculate-gate [--builds N]
# Requires: gh (authenticated) and push access to origin.

set -euo pipefail
cd "$(git rev-parse --show-toplevel)" # the build dir is its own toplevel

sha="$(git rev-parse HEAD)"
branch="speculation/$sha"

# THE BRANCH IS OWNED BY THE TRAP FROM HERE ON (bl-1ea9). It is the only thing
# this script puts on the PUBLIC remote, and it used to be deleted by two
# hand-rolled calls on two of the paths out — so a SIGINT, a dropped network or
# any `exit` added later between the push below and the delete stranded
# `speculation/<sha>` there. The header of this file conceded it: "sweep by
# hand". A trap set BEFORE the push cannot be outrun by a path nobody thought
# of, which is the whole class the hand-rolled calls missed.
#
# `verdicts` is folded in here rather than trapped separately, because two traps
# on EXIT would mean the second replacing the first — it is initialised empty so
# the cleanup is valid from this line, before the mktemp far below.
#
# SIGKILL and a lost machine are NOT covered and cannot be: nothing runs. The
# remote-side sweep in release-plz.yml (`prune stale branches`) is what collects
# those, and it deliberately skips `speculation/**` so it cannot delete a branch
# out from under a gate that is still running.
verdicts=""
cleanup() {
  git push origin --delete "refs/heads/$branch" >&2 || true
  [ -n "$verdicts" ] && rm -rf "$verdicts"
  return 0
}
trap cleanup EXIT INT TERM HUP

verdicts="$(mktemp -d)"

# The newest run on our branch. speculate.yml is the only workflow triggering
# on speculation/**, and the push that precedes the call mints a run. Keyed by
# branch rather than --workflow: gh cannot resolve a workflow by name until it
# has registered, which the first-ever push is still causing. Bounded wait.
await_run() {
  for _ in $(seq 30); do
    id="$(gh run list --branch "$branch" \
      --json databaseId --jq '.[0].databaseId' 2>/dev/null || true)"
    if [ -n "$id" ]; then
      printf '%s' "$id"
      return 0
    fi
    sleep 5
  done
  return 1
}

# One remote build: push, watch, fetch its verdict store. 0 iff a verdict for
# some (tree, gate) came home — the workflow records exactly one on any run that
# judged the tree, and nothing at all on a run that did not.
remote_build() {
  echo "speculate-gate: pushing candidate $sha to $branch" >&2
  # Explicitly, not by errexit: a function called in an `&&` list runs with
  # errexit suspended for its whole body, so an unreported push failure would
  # fall through into a 150-second wait for a run that can never appear.
  git push --force origin "HEAD:refs/heads/$branch" >&2 || return 1
  run_id="$(await_run)" || {
    echo "speculate-gate: no workflow run appeared for $branch" >&2
    return 1
  }
  echo "speculate-gate: watching run $run_id" >&2
  gh run watch "$run_id" -i 30 >/dev/null || true # the conclusion travels in the verdict
  rm -rf "$verdicts"
  mkdir -p "$verdicts"
  gh run download "$run_id" -n verdicts -D "$verdicts" >&2 || {
    echo "speculate-gate: no verdicts artifact on run $run_id" >&2
    return 1
  }
  compgen -G "$verdicts/*.toml" >/dev/null
}

remote_build || echo "speculate-gate: no verdict came home for $sha" >&2

if compgen -G "$verdicts/*.toml" >/dev/null; then
  bl-speculate import "$verdicts"/*.toml >&2 || true
fi

# NOT `exec` for any answer: exec REPLACES this shell, and a replaced shell
# runs no EXIT trap — so the success path, the one that runs every time, would
# be the one path that leaked the branch.
if bl-speculate check; then
  exit 0
fi
# The runner's verdict for THIS tree, under whatever key it was written:
# `<tree>-<gate>.toml` is the store's file name, the id being the path.
tree="$(git rev-parse 'HEAD^{tree}')"
if grep -qsx 'pass = false' "$verdicts/$tree"-*.toml; then
  echo "speculate-gate: the runner FAILED tree $tree" >&2
  exit 1
fi
echo "speculate-gate: no verdict for tree $tree under this box's gate key" >&2
echo "  (nothing came home, or a fingerprint miss) — exit 75, nothing recorded" >&2
exit 75
